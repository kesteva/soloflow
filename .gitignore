workflow-implementation-plan.md

# MCP server registrations — plugin policy is not to ship .mcp.json
# so it doesn't collide for users who already have these servers
# registered. Local dev registrations stay untracked.
.mcp.json

# Phase worktrees live as siblings of .soloflow/ at the repo root so they
# don't nest a .soloflow/ inside a .soloflow/. Each subdir is a transient
# git worktree managed by phase-worktree-setup.js / phase-worktree-merge.js.
.soloflow-worktrees/
